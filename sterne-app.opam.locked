build: [
  ["dune" "subst"] {pinned}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/thizanne/sterne.git"
pin-depends: ["sterne.dev" "git+ssh://git@github.com/thizanne/sterne.git"]
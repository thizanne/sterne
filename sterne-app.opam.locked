maintainer: "Thibault Suzanne <thi.suzanne@gmail.com>"
authors: "Thibault Suzanne <thi.suzanne@gmail.com>"
homepage: "https://github.com/thizanne/sterne"
bug-reports: "https://github.com/thizanne/sterne/issues"
